# ============================================================
# OMC 환경변수 템플릿
# 복사 후 .env로 저장하여 사용: cp .env.example .env
# .env는 gitignore 처리되어 있으므로 커밋되지 않음
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=omc
POSTGRES_PASSWORD=password
POSTGRES_DB=omc

# ── Spring Boot 서비스 공통 ───────────────────────────────────
# 로컬 bootRun: localhost 사용
# Docker Compose: 서비스명 사용 (postgres, redis, kafka)
DB_URL=localhost:5432
DB_USERNAME=omc
DB_PASSWORD=password

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_URI=localhost:9092

CONFIG_SERVER_URI=http://localhost:8888
EUREKA_URI=http://localhost:8761/eureka/

# ── Gateway ───────────────────────────────────────────────────
# 운영 환경에서는 반드시 강력한 시크릿으로 교체
GATEWAY_SECRET=local-secret

# ── JWT ───────────────────────────────────────────────────────
# 운영 환경에서는 반드시 강력한 시크릿으로 교체
JWT_SECRET=local-jwt-secret-please-change-in-production
