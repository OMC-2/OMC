            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"신규가입 1000원 할인\",\n  \"discountType\": \"AMOUNT\",\n  \"discountValue\": 1000,\n  \"totalQuantity\": 100,\n  \"startedAt\": \"2020-01-01T00:00:00\",\n  \"expiredAt\": \"2099-12-31T23:59:59\"\n}", "options": { "raw": { "language": "json" } } },
