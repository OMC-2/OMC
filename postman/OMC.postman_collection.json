    {
      "name": "🔥 Drop",
      "item": [
        {
          "name": "드롭 생성 (ADMIN)",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const fmt = d => new Date(d.getTime() + 9 * 3600000).toISOString().slice(0, 19);",
              "const now = new Date();",
              "pm.collectionVariables.set('dropStartAt', fmt(now));",
              "pm.collectionVariables.set('dropEndAt', fmt(new Date(now.getTime() + 5 * 60000)));"
            ], "type": "text/javascript" } },
            { "listen": "test", "script": { "exec": [
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "  pm.collectionVariables.set('dropId', pm.response.json().data.dropId);",
              "}"
            ], "type": "text/javascript" } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"startAt\": \"{{dropStartAt}}\",\n  \"endAt\": \"{{dropEndAt}}\",\n  \"totalQty\": 10,\n  \"holdTtlSec\": 300\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/drops", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","drops"] }
          }
        },
        {
          "name": "드롭 수정 (ADMIN)",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const fmt = d => new Date(d.getTime() + 9 * 3600000).toISOString().slice(0, 19);",
              "const now = new Date();",
              "pm.collectionVariables.set('dropStartAt', fmt(now));",
              "pm.collectionVariables.set('dropEndAt', fmt(new Date(now.getTime() + 5 * 60000)));"
            ], "type": "text/javascript" } }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"startAt\": \"{{dropStartAt}}\",\n  \"endAt\": \"{{dropEndAt}}\",\n  \"totalQty\": 20,\n  \"holdTtlSec\": 600\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/drops/{{dropId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","drops","{{dropId}}"] }
          }
        },
        {
          "name": "드롭 삭제 (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
