            ],
            "url": { "raw": "{{baseUrl}}/api/v1/coupons/{{couponId}}/issue", "host": ["{{baseUrl}}"], "path": ["api","v1","coupons","{{couponId}}","issue"] }
          }
        },
        {
          "name": "내 쿠폰 목록 조회",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/coupons/me?page=0&size=10", "host": ["{{baseUrl}}"], "path": ["api","v1","coupons","me"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "10" }] }
          }
        },
        {
          "name": "내 쿠폰 단건 조회",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/coupons/me/{{userCouponId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","coupons","me","{{userCouponId}}"] }
          }
        }
      ]
    },
    {
      "name": "📦 Product",
      "item": [
        {
          "name": "상품 등록 (ADMIN)",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200 || pm.response.code === 201) {",
            "  pm.collectionVariables.set('productId', pm.response.json().data.productId);",
            "}"
          ], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
