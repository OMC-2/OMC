{
  "info": {
    "name": "OMC API",
    "_postman_id": "omc-api-collection",
    "description": "OMC 전체 서비스 API 모음\n\n## 시작 전 설정\n1. Variables 탭에서 값 확인\n2. 회원가입 → 로그인 순서로 실행하면 accessToken 자동 세팅\n\n## 헤더 규칙\n- 게이트웨이 경유: X-Gateway-Secret 필수\n- 인증 필요: Authorization: Bearer {{accessToken}}\n- 어드민 전용: Authorization: Bearer {{adminToken}}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "paymentServiceUrl", "value": "http://localhost:8085", "type": "string" },
    { "key": "gatewaySecret", "value": "local-secret", "type": "string" },
    { "key": "adminSecret", "value": "local-admin-secret", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "couponId", "value": "", "type": "string" },
    { "key": "userCouponId", "value": "", "type": "string" },
    { "key": "productId", "value": "", "type": "string" },
    { "key": "dropId", "value": "", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" },
    { "key": "paymentId", "value": "", "type": "string" },
    { "key": "raffleId", "value": "", "type": "string" },
    { "key": "entryId", "value": "", "type": "string" },
    { "key": "addressId", "value": "", "type": "string" },
    { "key": "notificationId", "value": "", "type": "string" },
    { "key": "billingKeyId", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "dlqId", "value": "", "type": "string" },
    { "key": "dropStartAt", "value": "", "type": "string" },
    { "key": "dropEndAt", "value": "", "type": "string" },
    { "key": "raffleStartedAt", "value": "", "type": "string" },
    { "key": "raffleEndedAt", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "👤 User",
      "item": [
        {
          "name": "회원가입",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) {",
            "  const data = pm.response.json().data;",
            "  pm.collectionVariables.set('userId', data.userId);",
            "}"
          ], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"nickname\": \"testuser\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/users/signup", "host": ["{{baseUrl}}"], "path": ["api","v1","users","signup"] }
          }
        },
        {
          "name": "어드민 회원가입",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
              { "key": "X-Admin-Secret", "value": "{{adminSecret}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\",\n  \"nickname\": \"adminuser\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/users/admin/signup", "host": ["{{baseUrl}}"], "path": ["api","v1","users","admin","signup"] }
          }
        },
        {
          "name": "로그인 (USER)",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200) {",
            "  const data = pm.response.json().data;",
            "  pm.collectionVariables.set('accessToken', data.accessToken);",
            "  pm.collectionVariables.set('refreshToken', data.refreshToken);",
            "  pm.collectionVariables.set('userId', data.userId);",
            "}"
          ], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/users/login", "host": ["{{baseUrl}}"], "path": ["api","v1","users","login"] }
          }
        },
        {
          "name": "로그인 (ADMIN)",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200) {",
            "  const data = pm.response.json().data;",
            "  pm.collectionVariables.set('adminToken', data.accessToken);",
            "}"
          ], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/users/login", "host": ["{{baseUrl}}"], "path": ["api","v1","users","login"] }
          }
        },
        {
          "name": "토큰 갱신",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/users/token/refresh", "host": ["{{baseUrl}}"], "path": ["api","v1","users","token","refresh"] }
          }
        },
        {
          "name": "내 프로필 조회",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/users/me", "host": ["{{baseUrl}}"], "path": ["api","v1","users","me"] }
          }
        },
        {
          "name": "프로필 수정",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nickname\": \"newnickname\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/v1/users/me", "host": ["{{baseUrl}}"], "path": ["api","v1","users","me"] }
          }
        },
        {
          "name": "회원 탈퇴",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/users/me", "host": ["{{baseUrl}}"], "path": ["api","v1","users","me"] }
          }
        },
        {
          "name": "🏠 주소",
          "item": [
            {
              "name": "주소 등록",
              "event": [{ "listen": "test", "script": { "exec": [
                "if (pm.response.code === 201) {",
                "  pm.collectionVariables.set('addressId', pm.response.json().data.addressId);",
                "}"
              ], "type": "text/javascript" } }],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "body": { "mode": "raw", "raw": "{\n  \"recipientName\": \"홍길동\",\n  \"phone\": \"010-1234-5678\",\n  \"zipCode\": \"12345\",\n  \"address\": \"서울시 강남구 테헤란로 123\",\n  \"addressDetail\": \"456호\",\n  \"isDefault\": true\n}", "options": { "raw": { "language": "json" } } },
                "url": { "raw": "{{baseUrl}}/api/v1/users/addresses", "host": ["{{baseUrl}}"], "path": ["api","v1","users","addresses"] }
              }
            },
            {
              "name": "주소 목록 조회",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": { "raw": "{{baseUrl}}/api/v1/users/addresses", "host": ["{{baseUrl}}"], "path": ["api","v1","users","addresses"] }
              }
            },
            {
              "name": "주소 단건 조회",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": { "raw": "{{baseUrl}}/api/v1/users/addresses/{{addressId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","users","addresses","{{addressId}}"] }
              }
            },
            {
              "name": "주소 수정",
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "body": { "mode": "raw", "raw": "{\n  \"recipientName\": \"김철수\",\n  \"phone\": \"010-9999-8888\",\n  \"zipCode\": \"54321\",\n  \"address\": \"서울시 종로구 세종대로 1\",\n  \"addressDetail\": \"101호\"\n}", "options": { "raw": { "language": "json" } } },
                "url": { "raw": "{{baseUrl}}/api/v1/users/addresses/{{addressId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","users","addresses","{{addressId}}"] }
              }
            },
            {
              "name": "기본 주소 설정",
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": { "raw": "{{baseUrl}}/api/v1/users/addresses/{{addressId}}/default", "host": ["{{baseUrl}}"], "path": ["api","v1","users","addresses","{{addressId}}","default"] }
              }
            },
            {
              "name": "주소 삭제",
              "request": {
                "method": "DELETE",
                "header": [
                  { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": { "raw": "{{baseUrl}}/api/v1/users/addresses/{{addressId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","users","addresses","{{addressId}}"] }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "🎫 Coupon",
