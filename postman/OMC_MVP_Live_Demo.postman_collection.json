{
  "info": {
    "name": "🌟 OMC MVP Live Demo",
    "_postman_id": "omc-mvp-live-demo",
    "description": "MVP 시연 전용 포스트맨 컬렉션입니다. 위에서부터 아래로 순서대로 실행하세요.\n\n각 단계에서 발급된 ID값들은 자동으로 다음 단계의 변수로 세팅됩니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "paymentServiceUrl", "value": "http://localhost:8085", "type": "string" },
    { "key": "gatewaySecret", "value": "local-secret", "type": "string" },
    { "key": "adminSecret", "value": "local-admin-secret", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "couponId", "value": "", "type": "string" },
    { "key": "userCouponId", "value": "", "type": "string" },
    { "key": "productId", "value": "", "type": "string" },
    { "key": "dropId", "value": "", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" },
    { "key": "paymentId", "value": "", "type": "string" },
    { "key": "raffleId", "value": "", "type": "string" },
    { "key": "billingKeyId", "value": "", "type": "string" },
    { "key": "nowDate", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. ⚙️ [Admin] 어드민 회원가입",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
          { "key": "X-Admin-Secret", "value": "{{adminSecret}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin123@example.com\",\n  \"password\": \"password123\",\n  \"nickname\": \"adminuser\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/v1/users/admin/signup", "host": ["{{baseUrl}}"], "path": ["api","v1","users","admin","signup"] }
      }
    },
    {
      "name": "2. ⚙️ [Admin] 어드민 로그인",
      "event": [{ "listen": "test", "script": { "exec": [
        "if (pm.response.code === 200) {",
        "  const data = pm.response.json().data;",
        "  pm.collectionVariables.set('adminToken', data.accessToken);",
        "}"
      ], "type": "text/javascript" } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin123@example.com\",\n  \"password\": \"password123\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/v1/users/login", "host": ["{{baseUrl}}"], "path": ["api","v1","users","login"] }
      }
    },
    {
      "name": "3. ⚙️ [User] 일반 유저 회원가입",
      "event": [{ "listen": "test", "script": { "exec": [
        "if (pm.response.code === 201) {",
        "  const data = pm.response.json().data;",
        "  pm.collectionVariables.set('userId', data.userId);",
        "}"
      ], "type": "text/javascript" } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"user123@example.com\",\n  \"password\": \"password123\",\n  \"nickname\": \"testuser\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/v1/users/signup", "host": ["{{baseUrl}}"], "path": ["api","v1","users","signup"] }
      }
    },
    {
      "name": "4. ⚙️ [User] 일반 유저 로그인",
      "event": [{ "listen": "test", "script": { "exec": [
        "if (pm.response.code === 200) {",
        "  const data = pm.response.json().data;",
        "  pm.collectionVariables.set('accessToken', data.accessToken);",
        "  pm.collectionVariables.set('userId', data.userId);",
        "}"
      ], "type": "text/javascript" } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"user123@example.com\",\n  \"password\": \"password123\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/v1/users/login", "host": ["{{baseUrl}}"], "path": ["api","v1","users","login"] }
      }
    },
    {
      "name": "5. ⚙️ [Internal] 가상 빌링키 등록",
      "event": [{ "listen": "test", "script": { "exec": [
        "if (pm.response.code === 200 || pm.response.code === 201) {",
        "  pm.collectionVariables.set('billingKeyId', pm.response.json().billingKeyId);",
        "}"
      ], "type": "text/javascript" } }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"customerKey\": \"demo-customer-key\",\n  \"authKey\": \"demo-auth-key\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{paymentServiceUrl}}/internal/v1/payments/billing-keys", "host": ["{{paymentServiceUrl}}"], "path": ["internal","v1","payments","billing-keys"] }
      }
    },
    {
      "name": "6. 🎁 [Admin] 신규가입 할인 쿠폰 생성",
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "let date = new Date();",
          "date.setSeconds(date.getSeconds() + 1);",
          "let tzOffsetMs = date.getTimezoneOffset() * 60 * 1000;",
          "let localIso = new Date(date.getTime() - tzOffsetMs).toISOString().slice(0, 19);",
          "pm.collectionVariables.set('nowDate', localIso);"
        ], "type": "text/javascript" } },
        { "listen": "test", "script": { "exec": [
          "if (pm.response.code === 200 || pm.response.code === 201) {",
          "  pm.collectionVariables.set('couponId', pm.response.json().data.couponId);",
          "}"
        ], "type": "text/javascript" } }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"신규가입 5000원 할인\",\n  \"discountType\": \"AMOUNT\",\n  \"discountValue\": 5000,\n  \"totalQuantity\": 1000,\n  \"startedAt\": \"{{nowDate}}\",\n  \"expiredAt\": \"2099-12-31T23:59:59\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/v1/coupons", "host": ["{{baseUrl}}"], "path": ["api","v1","coupons"] }
      }
    },
    {
      "name": "7. 🎁 [Admin] 나이키 에어맥스 상품 등록",
      "event": [{ "listen": "test", "script": { "exec": [
        "if (pm.response.code === 200 || pm.response.code === 201) {",
        "  pm.collectionVariables.set('productId', pm.response.json().data.productId);",
        "}"
      ], "type": "text/javascript" } }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Nike Air Max 2024\",\n  \"description\": \"최신 에어맥스 운동화\",\n  \"price\": 150000,\n  \"brand\": \"Nike\",\n  \"category\": \"Sneakers\",\n  \"imageUrl\": \"https://example.com/image.jpg\",\n  \"initialQuantity\": 1000\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/v1/admin/products", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","products"] }
      }
    },
    {
      "name": "8. 🎁 [User] 유저 쿠폰 발급 받기",
      "event": [{ "listen": "test", "script": { "exec": [
        "if (pm.response.code === 200 || pm.response.code === 201) {",
        "  pm.collectionVariables.set('userCouponId', pm.response.json().data.userCouponId);",
        "}"
      ], "type": "text/javascript" } }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/v1/coupons/{{couponId}}/issue", "host": ["{{baseUrl}}"], "path": ["api","v1","coupons","{{couponId}}","issue"] }
      }
    },
    {
      "name": "9. 🔥 [Admin] 선착순 드롭 생성 및 오픈 (생성 후 5초 대기 필수!)",
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "let date = new Date();",
          "date.setSeconds(date.getSeconds() + 1);",
          "let tzOffsetMs = date.getTimezoneOffset() * 60 * 1000;",
          "let localIso = new Date(date.getTime() - tzOffsetMs).toISOString().slice(0, 19);",
          "pm.collectionVariables.set('nowDate', localIso);"
        ], "type": "text/javascript" } },
        { "listen": "test", "script": { "exec": [
          "if (pm.response.code === 200 || pm.response.code === 201) {",
          "  pm.collectionVariables.set('dropId', pm.response.json().data.dropId);",
          "}"
        ], "type": "text/javascript" } }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"startAt\": \"{{nowDate}}\",\n  \"endAt\": \"2099-12-31T18:00:00\",\n  \"totalQty\": 500,\n  \"holdTtlSec\": 300\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/v1/admin/drops", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","drops"] }
      }
    },
    {
      "name": "10. 🔥 [User] 드롭 선착순 구매 (쿠폰 적용)",
      "event": [{ "listen": "test", "script": { "exec": [
        "if (pm.response.code === 202) {",
        "  pm.collectionVariables.set('orderId', pm.response.json().data.orderId);",
        "}"
      ], "type": "text/javascript" } }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"billingKeyId\": \"{{billingKeyId}}\",\n  \"couponId\": \"{{userCouponId}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/v1/drops/{{dropId}}/purchase", "host": ["{{baseUrl}}"], "path": ["api","v1","drops","{{dropId}}","purchase"] }
      }
    },
    {
      "name": "11. 🎰 [Admin] 한정판 래플 생성",
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "let date = new Date();",
          "date.setSeconds(date.getSeconds() + 1);",
          "let tzOffsetMs = date.getTimezoneOffset() * 60 * 1000;",
          "let localIso = new Date(date.getTime() - tzOffsetMs).toISOString().slice(0, 19);",
          "pm.collectionVariables.set('nowDate', localIso);"
        ], "type": "text/javascript" } },
        { "listen": "test", "script": { "exec": [
          "if (pm.response.code === 200 || pm.response.code === 201) {",
          "  pm.collectionVariables.set('raffleId', pm.response.json().data.raffleId);",
          "}"
        ], "type": "text/javascript" } }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"dropId\": \"{{dropId}}\",\n  \"productId\": \"{{productId}}\",\n  \"name\": \"Nike 한정판 래플 시연\",\n  \"winnerCount\": 5,\n  \"startedAt\": \"{{nowDate}}\",\n  \"endedAt\": \"2099-12-31T23:59:59\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/v1/admin/raffles", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","raffles"] }
      }
    },
    {
      "name": "12. 🎰 [Admin] 래플 상태 변경 (OPEN)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"OPEN\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/v1/admin/raffles/{{raffleId}}/status", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","raffles","{{raffleId}}","status"] }
      }
    },
    {
      "name": "13. 🎰 [User] 래플 응모하기 (가결제)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"billingKeyId\": \"{{billingKeyId}}\",\n  \"couponId\": \"\",\n  \"originalAmount\": 150000,\n  \"discountAmount\": 0,\n  \"finalAmount\": 150000\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/v1/raffles/{{raffleId}}/entries", "host": ["{{baseUrl}}"], "path": ["api","v1","raffles","{{raffleId}}","entries"] }
      }
    },
    {
      "name": "14. 🎰 [Admin] 수동 추첨 실행",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/v1/admin/raffles/{{raffleId}}/draw", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","raffles","{{raffleId}}","draw"] }
      }
    },
    {
      "name": "15. 🎰 [User] 내 당첨 결과 확인",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/v1/raffles/{{raffleId}}/winners/me", "host": ["{{baseUrl}}"], "path": ["api","v1","raffles","{{raffleId}}","winners","me"] }
      }
    },
    {
      "name": "16. 🔔 [User] 내 알림 목록 조회",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Gateway-Secret", "value": "{{gatewaySecret}}" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/v1/notifications?page=0&size=10", "host": ["{{baseUrl}}"], "path": ["api","v1","notifications"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "10" }] }
      }
    }
  ]
}
